[global]
ioengine=libaio
direct=1
invalidate=1
group_reporting=1
time_based=1
runtime=60
ramp_time=10
randrepeat=0
norandommap=1
percentile_list=50:95:99:99.9
thread=1
filename=${FIO_TARGET}
refill_buffers=1
buffer_pattern=0xdeadbeef

rw=randread
bs=4k
numjobs=1
size=16g

[tail_mid_qd16]
iodepth=16

[tail_near_knee_qd64]
iodepth=64

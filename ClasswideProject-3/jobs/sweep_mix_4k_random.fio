[global]
ioengine=libaio
direct=1
invalidate=1
group_reporting=1
time_based=1
runtime=30
ramp_time=5
randrepeat=0
norandommap=1
percentile_list=50:95:99:99.9
thread=1
filename=${FIO_TARGET}
refill_buffers=1
buffer_pattern=0xdeadbeef

bs=4k
iodepth=32
numjobs=1
size=16g

[mix_100r]
rw=randread

[mix_100w]
rw=randwrite

[mix_70r30w]
rw=randrw
rwmixread=70

[mix_50r50w]
rw=randrw
rwmixread=50

[global]
ioengine=libaio
direct=1
invalidate=1
group_reporting=1
time_based=1
runtime=30
ramp_time=5
randrepeat=0
norandommap=1
percentile_list=50:95:99:99.9
thread=1
filename=${FIO_TARGET}
refill_buffers=1
buffer_pattern=0xdeadbeef

iodepth=1
numjobs=1

[rand_4k_read_qd1]
rw=randread
bs=4k
size=8g

[rand_4k_write_qd1]
rw=randwrite
bs=4k
size=8g

[seq_128k_read_qd1]
rw=read
bs=128k
size=16g

[seq_128k_write_qd1]
rw=write
bs=128k
size=16g
